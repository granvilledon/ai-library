# ============================================================
# 本地私有配置模板
#
# 用法：
#   1. 复制本文件为 application-local.yml（同目录）
#   2. 填入你自己的数据库口令与讯飞星火凭证
#   3. 启动时指定 profile：--spring.profiles.active=local
#      或设置环境变量 SPRING_PROFILES_ACTIVE=local
#
# application-local.yml 已被 .gitignore 排除，不会被提交。
# 也可以完全不建这个文件，改用环境变量：
#   DB_HOST / DB_PORT / DB_NAME / DB_USERNAME / DB_PASSWORD
#   SPARK_APP_ID / SPARK_API_KEY / SPARK_API_SECRET
#   JWT_SECRET
# ============================================================

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/ai_library?characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
    username: root
    password: ""

server:
  port: 8080
  servlet:
    context-path: "/api"

spark:
  app-id: "在这里填你的 APPID"
  api-key: "在这里填你的 APIKey"
  api-secret: "在这里填你的 APISecret"

jwt:
  tokenHeader: Authorization
  secret: "换成你自己的随机字符串"
  expiration: 36000000
  tokenHead: Bearer
